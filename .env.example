# Solo entorno local. No copiar credenciales de AWS.
APP_ENV=local
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://patron_test:CHANGE_ME@127.0.0.1:5432/patron_test
BLOB_ROOT=.local/blobs
MAIL_TRANSPORT=capture
MAIL_ROOT=.local/mail
# Generar fuera del repositorio; nunca usar este valor de ejemplo.
OPERATION_HMAC_KEY=CHANGE_ME

# Corpus local validado; indisponibilidad bloquea contraseñas nuevas, no el login.
PASSWORD_INDEX_ROOT=.local/password-index
PASSWORD_INDEX_APPROVAL=tools/assets/password-index.json

# CAD: origen del piloto autorizado; requiere que EC2 esté encendido.
# PATRON_API_ORIGIN=https://patronaje.77-113-63-190.sslip.io

# El runtime AWS usa la configuración de infra/aws/initialize-pilot.sh,
# generada en el servidor. No copiar sus secretos a este archivo.
